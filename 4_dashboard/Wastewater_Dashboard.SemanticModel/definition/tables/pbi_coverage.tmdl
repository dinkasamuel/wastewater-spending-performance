table pbi_coverage
	lineageTag: f6d55382-1f5f-5999-bf27-457d4efbd8ce

	column outcome
		dataType: string
		lineageTag: 8aaffbd5-496b-5b76-8c84-4bb23e9a2b03
		summarizeBy: none
		sourceColumn: outcome

		annotation SummarizationSetBy = User

	column reporting_year
		dataType: string
		lineageTag: fddacf7c-2ac0-5163-901d-a77ca6830ab1
		summarizeBy: none
		sourceColumn: reporting_year

		annotation SummarizationSetBy = User

	column companies_with_data
		dataType: int64
		lineageTag: 300df37b-df7c-5f8f-b4cb-60790d6da99e
		summarizeBy: none
		sourceColumn: companies_with_data

		annotation SummarizationSetBy = User

	partition pbi_coverage = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "pbi_coverage.csv"),[Delimiter=",", Columns=3, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"outcome", type text}, {"reporting_year", type text}, {"companies_with_data", Int64.Type}}, "en-GB")
				in
				    Typed

	annotation PBI_ResultType = Table
