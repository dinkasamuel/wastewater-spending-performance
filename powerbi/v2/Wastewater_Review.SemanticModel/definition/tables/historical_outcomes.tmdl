	partition historical_outcomes = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\HP\Desktop\CSCT Master's Project\Project_Review_Version_2026-11-16\data\fact_historical_outcomes.csv"),[Delimiter=",", Columns=16, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Nulls,{{"company_code", type text}, {"reporting_year", type text}, {"year_start", Int64.Type}, {"metric", type text}, {"value", type number}, {"raw_value", type text}, {"available", type text}, {"period_basis", type text}, {"period_start", type date}, {"period_end", type date}, {"source_file", type text}, {"source_sheet", type text}, {"source_cell", type text}, {"source_release", type text}, {"definition", type text}, {"source_metric_code", type text}},"en-GB")
				in Typed

	annotation PBI_ResultType = Table

