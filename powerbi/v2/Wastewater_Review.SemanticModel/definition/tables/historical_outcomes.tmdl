table historical_outcomes
	lineageTag: 1a1e05eb-5d85-5c37-996e-e92751022a01

	measure 'Selected historical rate' = IF(HASONEVALUE(historical_outcomes[metric]), AVERAGE(historical_outcomes[value]), BLANK())
		formatString: 0.00
		lineageTag: 8b098755-379c-46a4-80d2-65a84a5dd758

	measure 'Historical chart title' = IF(HASONEVALUE(historical_outcomes[metric]), SELECTEDVALUE(historical_outcomes[Outcome name]) & " | " & SELECTEDVALUE(historical_outcomes[Unit]) & " | blank = not available", "Select exactly one outcome to show its rate and unit")
		lineageTag: 707ea7e0-d21f-4c77-92d8-a7d5318ad19e

