table pbi_outcomes_long
	lineageTag: 6b4a5211-0fc1-5f6f-b9da-6c792695d60e

	measure 'Selected outcome value' = IF(HASONEVALUE(pbi_outcomes_long[outcome]), AVERAGE(pbi_outcomes_long[value]), BLANK())
		formatString: 0.00
		lineageTag: 83c99fe8-5064-5048-b6d3-e90334d43d50

	measure 'Outcome chart title' = IF(HASONEVALUE(pbi_outcomes_long[outcome]), SELECTEDVALUE(pbi_outcomes_long[outcome]) & " | " & SELECTEDVALUE(pbi_outcomes_long[unit]) & " | blank = not available", "Select exactly one outcome to show its values and unit")
		lineageTag: a24124b1-1399-5e8e-b1d1-8535ff105e71

