	partition pbi_outcomes_long = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "pbi_outcomes_long.csv"),[Delimiter=",", Columns=10, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"company_code", type text}, {"company_name", type text}, {"reporting_year", type text}, {"year_start", Int64.Type}, {"outcome", type text}, {"unit", type text}, {"period_basis", type text}, {"value", type number}, {"available", type text}, {"in_main_window", type text}}, "en-GB")
				in
				    Typed

	annotation PBI_ResultType = Table
