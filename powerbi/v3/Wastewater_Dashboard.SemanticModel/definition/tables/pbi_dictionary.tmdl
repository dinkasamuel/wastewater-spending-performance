	partition pbi_dictionary = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "pbi_dictionary.csv"),[Delimiter=",", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"measure", type text}, {"unit", type text}, {"better_direction", type text}, {"period", type text}, {"role", type text}, {"source", type text}, {"notes", type text}}, "en-GB")
				in
				    Typed

	annotation PBI_ResultType = Table
