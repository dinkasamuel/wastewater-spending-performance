	partition pbi_panel = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "pbi_panel.csv"),[Delimiter=",", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"company_code", type text}, {"company_name", type text}, {"reporting_year", type text}, {"year_start", Int64.Type}, {"base_spend_per_property_gbp", type number}, {"base_spend_gbp_m", type number}, {"properties", type number}, {"sewer_flooding_rate", type number}, {"sewer_collapse_rate", type number}, {"pollution_rate", type number}, {"treatment_compliance_pct", type number}}, "en-GB")
				in
				    Typed

	annotation PBI_ResultType = Table
