	partition pbi_models = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "pbi_models.csv"),[Delimiter=",", Columns=18, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
