				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"outcome", type text}, {"unit", type text}, {"specification", type text}, {"role", type text}, {"answers", type text}, {"spending_measure", type text}, {"outcome_source", type text}, {"years", type text}, {"company_years", Int64.Type}, {"companies", Int64.Type}, {"difference_per_10pct", type number}, {"ci95_low", type number}, {"ci95_high", type number}, {"range_includes_zero", type text}, {"p_wild_bootstrap", type number}, {"p_holm_main", type number}, {"detectable_difference_80pct", type number}, {"detectable_pct_of_average", type number}}, "en-GB")
				in
