model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder", "pbi_panel", "pbi_outcomes_long", "pbi_models", "pbi_detectability", "pbi_coverage", "pbi_dictionary"]

annotation PBI_ProTooling = ["DevMode"]

ref table pbi_panel
ref table pbi_outcomes_long
ref table pbi_models
ref table pbi_detectability
ref table pbi_coverage
ref table pbi_dictionary
